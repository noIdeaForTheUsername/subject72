[node name="TipsLabel" type="Label" parent="NoShader/MenuUI/InfoWindow/ScrollContainer/Control"]
layout_mode = 0
offset_left = 4.0
offset_top = 775.665
offset_right = 1094.0
offset_bottom = 1765.67
text = "(reading optional)

- React to the Subject-72's attacks as soon as possible. Some of them are easier to survive on a longer distance, some of them on a shorter - you need to learn what works the best for each attack. Between the attacks it's usually best to stay on a medium distance from the boss.

- Roll may sometimes help you avoid attacks. Also watch the Heal cooldown and use it as soon as it's ready.

- Avoid the monster's mouth (both during dash or normal movement) because it deals the most damage. Always watch out for the dash attack because it's the most dangerous one."
label_settings = SubResource("LabelSettings_gkx4b")
autowrap_mode = 3
uppercase = true

